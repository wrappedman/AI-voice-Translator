/* OpenSpeech AI — Windows resources */
#include <winver.h>

#define OSAI_VER_MAJOR 1
#define OSAI_VER_MINOR 0
#define OSAI_VER_PATCH 0
#define OSAI_VER_BUILD 0
#define OSAI_VERSION OSAI_VER_MAJOR,OSAI_VER_MINOR,OSAI_VER_PATCH,OSAI_VER_BUILD
#define OSAI_VERSION_STR "1.0.0.0"

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     OSAI_VERSION
PRODUCTVERSION  OSAI_VERSION
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenSpeech AI contributors"
            VALUE "FileDescription",  "OpenSpeech AI — offline speech recognition and translation"
            VALUE "FileVersion",      OSAI_VERSION_STR
            VALUE "InternalName",     "openspeech"
            VALUE "OriginalFilename", "OpenSpeechAI.exe"
            VALUE "ProductName",      "OpenSpeech AI"
            VALUE "ProductVersion",   OSAI_VERSION_STR
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "app.manifest"
