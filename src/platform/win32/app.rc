/* OpenSpeech AI — Windows resources */
#include <winver.h>
/* Version numbers come from src/core/osai_common.h through the header that
 * `make dist` generates; hard-coding them here is how the binary ended up
 * reporting 1.0.0.0 for a 1.1.0 release. */
#include "app_version.h"

#define OSAI_VERSION OSAI_VER_MAJOR,OSAI_VER_MINOR,OSAI_VER_PATCH,OSAI_VER_BUILD

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     OSAI_VERSION
PRODUCTVERSION  OSAI_VERSION
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenSpeech AI contributors"
            VALUE "FileDescription",  "OpenSpeech AI — offline speech recognition and translation"
            VALUE "FileVersion",      OSAI_VERSION_STR
            VALUE "InternalName",     "openspeech"
            VALUE "OriginalFilename", "OpenSpeechAI.exe"
            VALUE "ProductName",      "OpenSpeech AI"
            VALUE "ProductVersion",   OSAI_VERSION_STR
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "app.manifest"

/* The inference worker travels inside the executable. It is extracted to
 * <exe>/data/Cache on first activation, so a lone OpenSpeechAI.exe can still
 * download and activate models — no "keep the worker beside the exe" failure. */
OSAI_WORKER RCDATA "OpenSpeechWorker.exe"
