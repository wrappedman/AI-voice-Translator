# build output
build/
build_asan/
*.o
*.a
*.obj
*.pdb
*.ilk
a.out

# vendored toolchains fetched by `make bootstrap` (large, re-downloadable)
.cache/
zig/
ziglang/

# runtime data: never commit user audio, databases, logs or models
*.db
*.db-journal
*.db-wal
*.osam.tmp
*.osmt.tmp

# Release artifacts that DO ship in the repository:
#   dist/bin/OpenSpeechAI.exe          the built Windows binary
#   dist/OpenSpeechAI-*-win64.zip      the same binary, packaged
#   dist/checksums-*.txt               hashes for both
#   dist/models/                       the containers the build ships with
#                                      (generated by tools/export_models.py)
#
# Everything else `make dist` lays out next to the exe is regenerated from the
# repository (fonts, catalogue, docs), so it is not committed twice.
dist/bin/assets/
dist/bin/docs/
dist/bin/models/
dist/bin/README.md
# Everything else under dist/ is generated (screenshots are committed: they are
# the visual regression baseline).

# editor / OS noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# generated from OSAI_VERSION by tools/make_dist.py --rc-only
src/platform/win32/app_version.h

# python bytecode from the helper scripts
__pycache__/
*.pyc
